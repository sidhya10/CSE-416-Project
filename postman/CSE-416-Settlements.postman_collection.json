      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Report money sent with method', () => pm.response.to.have.status(200));",
              "const pair = pm.response.json().batch.pairs.find(p => p.senderId === pm.collectionVariables.get('memberId'));",
              "pm.test('Report does not settle debt', () => { pm.expect(pair.pendingCents).to.eql(2000); pm.expect(pair.confirmedCents).to.eql(0); });",
              "pm.collectionVariables.set('paymentIds', JSON.stringify(pair.pendingPayments.map(p => p.id)));"
            ]
          }
        }
      ]
