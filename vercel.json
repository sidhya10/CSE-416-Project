{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{.prisma/client,heic-convert,heic-decode,libheif-js,sharp,@img}/**"
    }
  },
  "crons": [
    {
      "path": "/api/jobs/daily",
      "schedule": "0 15 * * *"
    }
  ]
}
