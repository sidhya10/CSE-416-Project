{"kind":"textbox","id":"sh/krqx0vqt","slideIndex":3,"position":{"left":88.56,"top":120.24,"width":792.02,"height":61.6},"name":"Google Shape;285;p36","text":"Completed by July 12: Cloudflare restored the CPU safeguard and inspected all 3,868 managed rules.","geometry":"rect","lineWidth":0,"style":{"fontSize":22.67,"typeface":"Arial","color":"#F7F9FC","alignment":"left"}}
{"kind":"shape","id":"sh/jqhw7qp8","slideIndex":3,"position":{"left":64.8,"top":203.04,"width":7.92,"height":7.92},"name":"Google Shape;286;p36","geometry":"roundRect","fillColor":"#189D94","lineWidth":0,"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"center"}}
{"kind":"textbox","id":"sh/yp8fyl8n","slideIndex":3,"position":{"left":88.56,"top":193.68,"width":792.02,"height":61.6},"name":"Google Shape;287;p36","text":"Announced fixes: performance profiling, staged rule rollout, and a regex engine with runtime guarantees.","geometry":"rect","lineWidth":0,"style":{"fontSize":22.67,"typeface":"Arial","color":"#F7F9FC","alignment":"left"}}
{"kind":"shape","id":"sh/xoze5g72","slideIndex":3,"position":{"left":64.8,"top":276.48,"width":7.92,"height":7.92},"name":"Google Shape;288;p36","geometry":"roundRect","fillColor":"#189D94","lineWidth":0,"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"center"}}
{"kind":"textbox","id":"sh/wnqdwbqh","slideIndex":3,"position":{"left":88.56,"top":267.12,"width":792.02,"height":61.6},"name":"Google Shape;289;p36","text":"Technical debt lesson: fast global updates carried reliability risk. Missing performance checks let that risk accumulate.","geometry":"rect","lineWidth":0,"style":{"fontSize":22.67,"typeface":"Arial","color":"#F7F9FC","alignment":"left"}}
{"kind":"shape","id":"sh/mt4b6hof","slideIndex":3,"position":{"left":64.8,"top":349.92,"width":7.92,"height":7.92},"name":"Google Shape;290;p36","geometry":"roundRect","fillColor":"#189D94","lineWidth":0,"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"center"}}
