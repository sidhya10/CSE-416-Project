FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS build
COPY package.json package-lock.json ./
COPY client/package.json ./client/package.json
COPY server/package.json ./server/package.json
COPY shared/package.json ./shared/package.json
COPY prisma ./prisma
RUN npm ci --include=dev
COPY tsconfig.base.json ./
COPY shared ./shared
COPY server ./server
RUN npm run prisma:generate && npm run build --workspace shared && npm run build --workspace server

FROM base AS runtime
ENV NODE_ENV=production PORT=8000
# Keep Prisma CLI for startup migrations. No credentials are needed at build time.
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 8000
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && exec node server/dist/server.js"]
