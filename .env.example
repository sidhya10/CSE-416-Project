# Runtime
NODE_ENV=development

# Client (root .env is loaded by Vite; only VITE_ variables reach the browser)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_GOOGLE_CLIENT_ID=

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cse416?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters

# Google Identity Services: same OAuth Web client ID as VITE_GOOGLE_CLIENT_ID.
# No client secret is needed for the popup ID-token flow.
GOOGLE_CLIENT_ID=

# Bank integrations
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Optional (32+ chars). Encrypts stored Plaid access tokens; defaults to a key derived from JWT_SECRET.
BANK_TOKEN_KEY=

# Azure receipt parsing (server only; never use VITE_ for the key)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# App-wide attempts per UTC month; use a dedicated F0 resource. 0 disables new scans.
RECEIPT_MONTHLY_PAGE_LIMIT=450
RECEIPT_DAILY_USER_LIMIT=20
