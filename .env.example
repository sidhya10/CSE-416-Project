# Runtime
NODE_ENV=development

# Client
VITE_API_BASE_URL=http://localhost:3000/api
VITE_GOOGLE_CLIENT_ID=

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cse416?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters

# Future integrations
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure receipt parsing (server only; never use VITE_ for the key)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# App-wide attempts per UTC month; use a dedicated F0 resource. 0 disables new scans.
RECEIPT_MONTHLY_PAGE_LIMIT=450
RECEIPT_DAILY_USER_LIMIT=20
