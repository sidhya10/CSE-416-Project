generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  budgetNotices BudgetNotice[]
  id                    String               @id @default(cuid())
  email                 String               @unique
  username              String               @unique
  passwordHash          String?
  googleSubject         String?              @unique
  name                  String
  phone                 String?              @unique
  birthday              DateTime?
  bio                   String               @default("")
  photoUrl              String?              @db.Text
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdSettlements    SettlementBatch[]
  settlementNotices     SettlementNotice[]
  createdRecurringBills RecurringBill[]
  bankConnections       BankConnection[]
  categoryLimits        CategoryLimit[]
  whatIfScenarios       WhatIfScenario[]
  createdExpenses       Expense[]            @relation("ExpenseCreator")
  paidExpenses          Expense[]            @relation("ExpensePayer")
  expenseShares         ExpenseShare[]
  receiptScans          ReceiptScan[]
  friendshipsOne        Friendship[]         @relation("FriendshipOne")
  friendshipsTwo        Friendship[]         @relation("FriendshipTwo")
  createdGroups         Group[]              @relation("GroupCreator")
  groupMemberships      GroupMembership[]
  groupInvitations      GroupInvitation[]    @relation("GroupInvitationRecipient")
  sentGroupInvitations  GroupInvitation[]    @relation("GroupInvitationSender")
  passwordResetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Friendship {
  id        String   @id @default(cuid())
  userOneId String
  userTwoId String
  createdAt DateTime @default(now())
  userOne   User     @relation("FriendshipOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo   User     @relation("FriendshipTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupInvitationStatus {
  ACCEPTED
  REVOKED
}

model Group {
  id             String            @id @default(cuid())
  name           String
  description    String            @default("")
  type           String            @default("General")
  color          String            @default("gold")
  photoUrl       String?           @db.Text
  startDate      DateTime?
  endDate        DateTime?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      User              @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  settlements    SettlementBatch[]
  expenses       Expense[]
  memberships    GroupMembership[]
  recurringBills RecurringBill[]
  budgetPlan     GroupBudgetPlan?
  archivedAt     DateTime?
  archiveReason  String?
  inactivityDays Int               @default(60)
  lastActivityAt DateTime          @default(now())
  invitations    GroupInvitation[]

  @@index([createdById])
  @@index([archivedAt, lastActivityAt])
}

model GroupMembership {
  id             String    @id @default(cuid())
  groupId        String
  userId         String
  role           GroupRole @default(MEMBER)
  joinedAt       DateTime  @default(now())
  lastAccessedAt DateTime?
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvitation {
  id            String                @id @default(cuid())
  groupId       String
  invitedUserId String
  invitedById   String
  role          GroupRole             @default(MEMBER)
  status        GroupInvitationStatus @default(ACCEPTED)
  createdAt     DateTime              @default(now())
  acceptedAt    DateTime?
  group         Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedUser   User                  @relation("GroupInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy     User                  @relation("GroupInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([groupId, invitedUserId])
  @@index([invitedUserId])
  @@index([invitedById])
}

enum ExpenseSplitMode {
  EQUAL
  ITEMS
  CUSTOM
}

model Expense {
  budgetNotices BudgetNotice[]
  budgetCategory String @default("other")
  budgetLinkReviewed Boolean @default(false)
  bankTransactionId String? @unique
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  id                String           @id @default(cuid())
  settlementBatchId String?
  settlementBatch   SettlementBatch? @relation(fields: [settlementBatchId], references: [id], onDelete: SetNull)
  groupId           String
  group             Group            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdByUserId   String
  creator           User             @relation("ExpenseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  paidByUserId      String
  payer             User             @relation("ExpensePayer", fields: [paidByUserId], references: [id], onDelete: Restrict)
  title             String
  expenseDate       DateTime         @db.Date
  currency          String           @default("USD")
  splitMode         ExpenseSplitMode
  taxCents          Int              @default(0)
  tipCents          Int              @default(0)
  otherCents        Int              @default(0)
  totalCents        Int
  version           Int              @default(1)
  // Retried create requests return the existing expense, rather than posting it twice.
  clientRequestId   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  recurringBillId   String?
  recurringBill     RecurringBill?   @relation(fields: [recurringBillId], references: [id], onDelete: Restrict)
  cycleDate         DateTime?        @db.Date
  receipt           ExpenseReceipt?
  items             ExpenseItem[]
  shares            ExpenseShare[]

  @@unique([recurringBillId, cycleDate])
  @@unique([createdByUserId, clientRequestId])
  @@index([settlementBatchId])
  @@index([groupId, createdAt])
}

model ExpenseItem {
  id             String           @id @default(cuid())
  expenseId      String
  expense        Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name           String
  unitPriceCents Int
  quantity       Int
  position       Int
  assignments    ItemAssignment[]

  @@unique([expenseId, id])
  @@unique([expenseId, position])
}

model ExpenseShare {
  budgetCategory String @default("other")
  expenseId       String
  userId          String
  expense         Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  position        Int
  baseCents       Int
  totalCents      Int
  assignments     ItemAssignment[]
  settlementShare SettlementShare?
  payments        ExpensePayment[]

  @@id([expenseId, userId])
  @@unique([expenseId, position])
  @@index([userId])
}

model ItemAssignment {
  expenseId String
  itemId    String
  userId    String
  item      ExpenseItem  @relation(fields: [expenseId, itemId], references: [expenseId, id], onDelete: Cascade)
  share     ExpenseShare @relation(fields: [expenseId, userId], references: [expenseId, userId], onDelete: Cascade)

  @@id([expenseId, itemId, userId])
}

enum ExpensePaymentStatus {
  SENT
  CONFIRMED
  ISSUE
}

model ExpensePayment {
  id              String               @id @default(cuid())
  expenseId       String
  senderUserId    String
  share           ExpenseShare         @relation(fields: [expenseId, senderUserId], references: [expenseId, userId], onDelete: Restrict)
  amountCents     Int
  method          String?
  status          ExpensePaymentStatus @default(SENT)
  clientRequestId String
  sentAt          DateTime             @default(now())
  resolvedAt      DateTime?

  @@unique([senderUserId, clientRequestId])
  @@index([expenseId])
}

// User-scoped normalized OCR cache; images and full provider responses are not stored.
model ReceiptScan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  status    String   @default("PENDING")
  result    Json?
  createdAt DateTime @default(now())

  @@unique([userId, hash])
  @@index([userId, createdAt])
}

// Conservative attempt counter survives cache deletion and process restarts.
model ReceiptUsage {
  id           String    @id
  month        String
  attempts     Int       @default(0)
  busyUntil    DateTime?
  activeScanId String?
}

model ExpenseReceipt {
  expenseId String  @id
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  data      Bytes
}

model RecurringBill {
  id            String           @id @default(cuid())
  groupId       String
  group         Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById   String
  creator       User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  title         String
  amountCents   Int
  startDate     DateTime         @db.Date
  intervalEvery Int
  intervalUnit  String
  frequency     String
  defaultPlan   Json
  nextCycle     Int              @default(0)
  paused        Boolean          @default(false)
  error         String?
  createdAt     DateTime         @default(now())
  cycles        RecurringCycle[]
  expenses      Expense[]

  @@index([groupId])
}

model RecurringCycle {
  billId String
  bill   RecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  index  Int
  plan   Json

  @@id([billId, index])
}

model BankConnection {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId     String        @unique
  institutionName String
  accessTokenEnc  String
  syncCursor      String?
  status          String        @default("ACTIVE")
  statusDetail    String?
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  accounts        BankAccount[]

  @@index([userId])
}

model BankAccount {
  id             String            @id @default(cuid())
  connectionId   String
  connection     BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  plaidAccountId String            @unique
  name           String
  nickname       String?
  mask           String            @default("")
  balanceCents   Int               @default(0)
  hidden         Boolean           @default(false)
  transactions   BankTransaction[]

  @@index([connectionId])
}

model BankTransaction {
  linkedExpense Expense?
  id                 String      @id @default(cuid())
  accountId          String
  account            BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidTransactionId String      @unique
  amountCents        Int
  date               DateTime    @db.Date
  name               String
  merchant           String?
  category           String?
  pending            Boolean     @default(false)

  @@index([accountId, date])
}

// Per-user monthly limit for one of the fixed budget categories (see budget.categories.ts).
// A missing row, or a limit of 0, means no limit is set for that category.
model CategoryLimit {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String
  limitCents Int
  updatedAt  DateTime @updatedAt

  @@unique([userId, category])
}

// A named set of category limits saved from the What-if simulator. `limits` maps category keys to
// monthly limits in cents. It never changes the real budget; applying a scenario writes CategoryLimit rows.
model WhatIfScenario {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  limits    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// Shared monthly plan for a group, set by an owner or admin. No row means no plan is set.
model GroupBudgetPlan {
  groupId      String   @id
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  plannedCents Int
  updatedAt    DateTime @updatedAt
}

// Each expense is assigned to at most one settlement period. Original shares remain the ledger.
model SettlementBatch {
  id              String             @id @default(cuid())
  groupId         String
  group           Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById     String?
  creator         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  clientRequestId String
  createdAt       DateTime           @default(now())
  expenses        Expense[]
  shares          SettlementShare[]
  notices         SettlementNotice[]

  @@unique([createdById, clientRequestId])
  @@index([groupId, createdAt])
}

model SettlementShare {
  expenseId              String
  userId                 String
  source                 ExpenseShare    @relation(fields: [expenseId, userId], references: [expenseId, userId], onDelete: Cascade)
  batchId                String
  batch                  SettlementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  amountCents            Int
  baselineConfirmedCents Int

  @@id([expenseId, userId])
  @@index([batchId])
}

model SettlementNotice {
  id          String          @id @default(cuid())
  batchId     String
  batch       SettlementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  kind        String
  message     String
  createdAt   DateTime        @default(now())
  readAt      DateTime?

  @@index([recipientId, readAt])
  @@index([batchId, actorId, recipientId, kind, createdAt])
}

model BudgetNotice {
  id String @id @default(cuid())
  expenseId String
  recipientId String
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  message String
  createdAt DateTime @default(now())
  readAt DateTime?
  @@unique([expenseId, recipientId])
}
